ENV=development
DEBUG=true

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=project_management

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
S3_BUCKET_NAME=project-management-documents
S3_ENDPOINT_URL=

MAX_PROJECT_STORAGE_BYTES=104857600

SHARE_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_BASE_URL=http://localhost:8000

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- AI assistant ---------------------------------------------------------
# Language model: ollama (free, local) | anthropic | openai | none
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
# Only needed if you switch LLM_PROVIDER to anthropic or openai (paid APIs).
# Never commit real keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings: ollama (free, local) | huggingface (needs `uv sync --extra huggingface`) | hash
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Retrieval and context management
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=4
CHAT_HISTORY_TURNS=6
CONTEXT_CHAR_BUDGET=12000
